---
interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---

<div class="my-8 border-l-4 border-green-500 bg-green-50 rounded-r-lg p-8">
  <h3 class="text-h4 font-bold mb-4 flex items-center gap-3 text-green-700">
    <span class="text-2xl">✓</span>
    {title}
  </h3>
  <ul class="space-y-3">
    {items.map((item) => (
      <li class="flex items-start gap-3">
        <span class="text-green-500 font-bold mt-1">•</span>
        <span class="text-text-primary">{item}</span>
      </li>
    ))}
  </ul>
</div>
