---
interface Props {
  code: string;
  language?: string;
  label?: string;
}

const { code, language = 'bash', label } = Astro.props;
---

<div class="my-8">
  {label && (
    <div class="text-sm font-medium text-text-secondary mb-2 px-1">
      {label}
    </div>
  )}
  <div class="relative bg-[#1A1A1A] text-[#F0F0F0] rounded-xl overflow-hidden font-mono text-sm">
    <button
      class="copy-btn absolute top-3 right-3 bg-[#333] hover:bg-elink text-white px-3 py-1 rounded-md text-xs font-medium transition-colors duration-200"
      data-code={code}
      title="Copiar al portapapers"
    >
      Copiar
    </button>
    <pre class="p-5 pr-24 overflow-x-auto leading-relaxed"><code class={`language-${language}`}>{code}</code></pre>
  </div>
</div>

<script>
  document.querySelectorAll('.copy-btn').forEach((button) => {
    button.addEventListener('click', async (e) => {
      const el = e.target as HTMLElement;
      const code = el.getAttribute('data-code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const original = el.textContent;
        el.textContent = 'Copiat!';
        el.classList.add('bg-green-600');
        setTimeout(() => {
          el.textContent = original;
          el.classList.remove('bg-green-600');
        }, 2000);
      } catch {
        console.error('Error al copiar');
      }
    });
  });
</script>
