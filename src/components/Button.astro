---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
}

const { href, label, variant = 'primary', size = 'md' } = Astro.props;

const classes = {
  base: 'inline-block rounded-lg font-medium transition-colors',
  variant: {
    primary: 'btn-primary',
    secondary: 'btn-secondary',
  },
  size: {
    sm: 'px-4 py-2 text-sm',
    md: 'px-6 py-3',
    lg: 'px-8 py-4 text-lg',
  },
};
---

<a href={href} class={`${classes.base} ${classes.variant[variant]} ${classes.size[size]}`}>
  {label}
</a>
