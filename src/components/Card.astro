---
interface Props {
  title: string;
  icon?: string;
}

const { title, icon = '📦' } = Astro.props;
---

<div class="p-8 rounded-lg border border-gray-200 hover:border-elink transition-colors bg-white">
  <div class="text-4xl mb-4">{icon}</div>
  <h3 class="text-h4 mb-2">{title}</h3>
  <slot />
</div>
