---
interface Props {
  href: string;
  filename: string;
}

const { href, filename } = Astro.props;
---

<div class="my-8">
  <a 
    href={href}
    download={filename}
    class="inline-flex items-center gap-3 px-6 py-4 bg-elink text-white font-semibold rounded-lg hover:opacity-90 transition-opacity shadow-sm hover:shadow-md"
  >
    <span class="text-2xl">📄</span>
    <div>
      <div class="text-sm font-normal opacity-90">Descarrega la presentació</div>
      <div>{filename}</div>
    </div>
  </a>
</div>
