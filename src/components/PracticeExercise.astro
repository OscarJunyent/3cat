---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="my-8 border-l-4 border-elink bg-[#FFF8F8] rounded-r-xl overflow-hidden">
  <div class="p-8">
    <h3 class="text-[1.05rem] text-elink font-bold mb-5 flex items-center gap-3 tracking-tight">
      <span class="text-xl">✏️</span>
      {title}
    </h3>
    <div class="text-text-primary space-y-4">
      <slot />
    </div>
  </div>
</div>
