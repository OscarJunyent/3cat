---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="my-8 border-l-4 border-elink bg-elink/5 rounded-r-lg overflow-hidden">
  <div class="p-8">
    <h3 class="text-h4 text-elink font-bold mb-6 flex items-center gap-3">
      <span class="text-2xl">✏️</span>
      {title}
    </h3>
    <div class="text-text-primary space-y-4">
      <slot />
    </div>
  </div>
</div>
