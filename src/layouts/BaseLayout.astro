---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const blocs = await getCollection('blocs');
const blocsOrdered = blocs.sort((a, b) => a.data.order - b.data.order);

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '3Cat × Elink - Portal de Formació en IA',
  description = "Portal de materials de formació en Intel·ligència Artificial per a l'àrea d'Enginyeria de 3Cat.",
} = Astro.props;
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white text-text-primary">

    <!-- HEADER -->
    <header class="sticky top-0 z-50 bg-white border-b border-border-subtle">
      <div class="container-max flex items-center justify-between h-16">

        <!-- Logo -->
        <a href="/" class="no-underline flex-shrink-0">
          <img src="/images/elinkcat_logo.png" alt="Elinkcat" class="h-7" />
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-7">
          <a href="/"
            class="text-sm font-medium text-[#444] hover:text-elink no-underline transition-colors">
            Inici
          </a>

          <!-- Blocs dropdown -->
          <div class="relative group">
            <button class="flex items-center gap-1 text-sm font-medium text-[#444] hover:text-elink transition-colors py-1 cursor-default">
              Blocs
              <svg class="w-3.5 h-3.5 mt-0.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown panel -->
            <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-[580px] bg-white border border-border-subtle rounded-xl shadow-[0_4px_20px_rgba(0,0,0,0.1)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
              <div class="p-3 grid grid-cols-2 gap-1">
                {blocsOrdered.map((b) => (
                  <a
                    href={`/${b.data.blockId}`}
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-bg-light no-underline transition-colors group/item"
                  >
                    <span class="w-9 h-9 rounded-lg bg-code-bg text-text-secondary text-sm font-bold flex items-center justify-center flex-shrink-0 group-hover/item:bg-elink group-hover/item:text-white transition-colors">
                      {b.data.number}
                    </span>
                    <div class="min-w-0">
                      <div class="text-sm font-medium text-text-primary group-hover/item:text-elink transition-colors truncate">
                        {b.data.title}
                      </div>
                      <div class="text-xs text-[#999] mt-0.5">{b.data.duration}</div>
                    </div>
                  </a>
                ))}
              </div>
              <div class="px-4 py-3 border-t border-border-subtle">
                <a href="/blocs" class="text-sm text-elink font-medium no-underline hover:underline">
                  Veure tots els blocs →
                </a>
              </div>
            </div>
          </div>

          <a href="/feedback"
            class="text-sm font-medium text-[#444] hover:text-elink no-underline transition-colors">
            Feedback
          </a>

          <a href="https://elink.cat" target="_blank" rel="noopener noreferrer" class="no-underline">
            <span class="inline-flex items-center px-4 py-2 border border-elink text-elink text-sm font-medium rounded-lg hover:bg-elink hover:text-white transition-colors cursor-pointer">
              Visita Elinkcat
            </span>
          </a>
        </nav>

        <!-- Mobile hamburger -->
        <button id="mobileMenuBtn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Obrir menú">
          <span class="block w-5 h-0.5 bg-text-primary transition-all"></span>
          <span class="block w-5 h-0.5 bg-text-primary transition-all"></span>
          <span class="block w-5 h-0.5 bg-text-primary transition-all"></span>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobileMenu" class="hidden md:hidden border-t border-border-subtle bg-white">
        <div class="container-max py-4">
          <a href="/" class="flex items-center py-3 text-sm font-medium text-text-primary hover:text-elink no-underline border-b border-[#F5F5F5]">
            Inici
          </a>
          <div class="py-3 border-b border-[#F5F5F5]">
            <div class="text-xs font-semibold text-[#999] uppercase tracking-wider mb-2">Blocs</div>
            <div class="space-y-1">
              {blocsOrdered.map((b) => (
                <a
                  href={`/${b.data.blockId}`}
                  class="flex items-center gap-3 py-2 text-sm text-text-primary hover:text-elink no-underline"
                >
                  <span class="w-6 h-6 rounded bg-code-bg text-text-secondary text-xs font-bold flex items-center justify-center flex-shrink-0">
                    {b.data.number}
                  </span>
                  {b.data.title}
                </a>
              ))}
            </div>
          </div>
          <a href="/feedback" class="flex items-center py-3 text-sm font-medium text-text-primary hover:text-elink no-underline border-b border-[#F5F5F5]">
            Feedback
          </a>
          <a href="https://elink.cat" target="_blank" rel="noopener noreferrer" class="flex items-center py-3 text-sm font-medium text-elink no-underline">
            Visita Elinkcat ↗
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-bg-dark text-white mt-20">
      <div class="container-max py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-8">

          <div>
            <img src="/images/elinkcat_logo.png" alt="Elinkcat" class="h-6 mb-5 brightness-0 invert" />
            <p class="text-sm text-[#888] leading-relaxed">
              Portal de materials de formació en Intel·ligència Artificial impartida per Elinkcat
              a l'àrea d'Enginyeria de 3Cat (CCMA).
            </p>
          </div>

          <div>
            <h4 class="text-sm font-semibold text-white mb-4">Enllaços</h4>
            <ul class="space-y-2.5">
              <li>
                <a href="https://elink.cat" target="_blank" rel="noopener noreferrer"
                  class="text-[#AAA] hover:text-white text-sm no-underline transition-colors">
                  Elinkcat
                </a>
              </li>
              <li>
                <a href="https://www.ccma.cat" target="_blank" rel="noopener noreferrer"
                  class="text-[#AAA] hover:text-white text-sm no-underline transition-colors">
                  3Cat (CCMA)
                </a>
              </li>
            </ul>
          </div>

          <div>
            <h4 class="text-sm font-semibold text-white mb-4">Recursos</h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/blocs" class="text-[#AAA] hover:text-white text-sm no-underline transition-colors">
                  Blocs de contingut
                </a>
              </li>
              <li>
                <a href="/feedback" class="text-[#AAA] hover:text-white text-sm no-underline transition-colors">
                  Envia feedback
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="border-t border-[#333] pt-6 text-center">
          <p class="text-xs text-[#555]">© 2026 Elinkcat × 3Cat (CCMA). Tots els drets reservats.</p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobileMenuBtn');
      const menu = document.getElementById('mobileMenu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>
  </body>
</html>
