---
import BaseLayout from '../layouts/BaseLayout.astro';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const hasFormspreeId = !!formspreeId;

if (!hasFormspreeId) {
  console.warn('⚠️ PUBLIC_FORMSPREE_ID no està configurada. El formulari de feedback serà funcional però no enviarà dades.');
}
---

<BaseLayout title="Feedback - 3Cat × Elink">
  <section class="section-padding container-max">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-center mb-3 text-elink">El teu feedback</h1>
      <p class="text-center text-lg text-text-secondary mb-12">
        Les teves opinions ens ajuden a millorar el programa. Pots enviar tants comentaris com vulguis al llarg de la formació.
      </p>

      <form id="feedbackForm" class="space-y-8">
        {/* Nom */}
        <div>
          <label for="nom" class="block text-sm font-medium text-text-primary mb-2">
            Nom
          </label>
          <input
            type="text"
            id="nom"
            name="nom"
            placeholder="Opcional"
            class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-elink focus:border-transparent transition-all"
          />
        </div>

        {/* Rol */}
        <div>
          <label for="rol" class="block text-sm font-medium text-text-primary mb-2">
            Rol <span class="text-elink">*</span>
          </label>
          <select
            id="rol"
            name="rol"
            required
            class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-elink focus:border-transparent transition-all bg-white"
          >
            <option value="">Selecciona el teu rol...</option>
            <option value="Developer">Developer</option>
            <option value="Product Owner">Product Owner</option>
            <option value="UX/UI">UX/UI</option>
            <option value="Altres">Altres</option>
          </select>
        </div>

        {/* Bloc valorat */}
        <div>
          <label for="bloc" class="block text-sm font-medium text-text-primary mb-2">
            Bloc valorat <span class="text-elink">*</span>
          </label>
          <select
            id="bloc"
            name="bloc"
            required
            class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-elink focus:border-transparent transition-all bg-white"
          >
            <option value="">Selecciona el bloc...</option>
            <option value="Bloc 1 - Fonaments GitHub Copilot">Bloc 1 - Fonaments GitHub Copilot</option>
            <option value="Bloc 2 - Agents i Skills">Bloc 2 - Agents i Skills</option>
            <option value="Bloc 3 - MCP i Protocols">Bloc 3 - MCP i Protocols</option>
            <option value="Bloc 4 - IA al Cicle de Vida">Bloc 4 - IA al Cicle de Vida</option>
            <option value="Bloc A - Interfícies amb IA">Bloc A - Interfícies amb IA</option>
            <option value="Bloc B - Design System">Bloc B - Design System com a Skills</option>
            <option value="Hackathon">Hackathon</option>
            <option value="Programa en conjunt">Programa en conjunt</option>
          </select>
        </div>

        {/* Valoració general (estrelles) */}
        <div>
          <label class="block text-sm font-medium text-text-primary mb-4">
            Valoració general <span class="text-elink">*</span>
          </label>
          <div class="flex gap-4 items-center">
            <div id="starsContainer" class="flex gap-2">
              {[1, 2, 3, 4, 5].map((star) => (
                <button
                  key={star}
                  type="button"
                  data-rating={star}
                  class="star-rating text-3xl cursor-pointer transition-transform hover:scale-110"
                  aria-label={`Valoració ${star} estrelles`}
                >
                  ☆
                </button>
              ))}
            </div>
            <span id="ratingValue" class="text-sm text-text-secondary"></span>
          </div>
          <input type="hidden" id="rating" name="rating" required />
        </div>

        {/* Què t'ha funcionat millor? */}
        <div>
          <label for="millor" class="block text-sm font-medium text-text-primary mb-2">
            Què t'ha funcionat millor? <span class="text-elink">*</span>
          </label>
          <textarea
            id="millor"
            name="millor"
            required
            minlength="10"
            rows="4"
            placeholder="Explica quins aspectes del programa t'han agradat més..."
            class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-elink focus:border-transparent transition-all resize-vertical"
          ></textarea>
          <span id="millorCount" class="text-xs text-text-secondary mt-1 inline-block"></span>
        </div>

        {/* Què milloraries? */}
        <div>
          <label for="millorar" class="block text-sm font-medium text-text-primary mb-2">
            Què milloraries? <span class="text-elink">*</span>
          </label>
          <textarea
            id="millorar"
            name="millorar"
            required
            minlength="10"
            rows="4"
            placeholder="Suggereix millores o aspectes que es podrien potenciar..."
            class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-elink focus:border-transparent transition-all resize-vertical"
          ></textarea>
          <span id="millorarCount" class="text-xs text-text-secondary mt-1 inline-block"></span>
        </div>

        {/* Has aplicat alguna cosa? */}
        <div>
          <label for="aplicat" class="block text-sm font-medium text-text-primary mb-2">
            Has aplicat alguna cosa al teu dia a dia?
          </label>
          <textarea
            id="aplicat"
            name="aplicat"
            rows="3"
            placeholder="Opcional: explica si has posat en pràctica algún concepte..."
            class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-elink focus:border-transparent transition-all resize-vertical"
          ></textarea>
        </div>

        {/* Email */}
        <div>
          <label for="email" class="block text-sm font-medium text-text-primary mb-2">
            Email per fer seguiment
          </label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Opcional"
            class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-elink focus:border-transparent transition-all"
          />
          <p class="text-xs text-text-secondary mt-1">
            T'ajudarà a rebre comunicacions de seguiment sobre el programa
          </p>
        </div>

        {/* Avís de privacitat */}
        <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg">
          <p class="text-xs text-text-secondary">
            <strong>Privacitat:</strong> Les respostes es comparteixen amb l'equip d'Elinkcat per a la millora del programa. No es comparteixen amb tercers.
          </p>
        </div>

        {/* Submit */}
        <div class="pt-4">
          <button
            type="submit"
            id="submitBtn"
            disabled={!hasFormspreeId}
            class={`w-full py-3 rounded-lg font-semibold transition-all ${
              hasFormspreeId
                ? 'btn-primary hover:opacity-90'
                : 'bg-gray-300 text-gray-500 cursor-not-allowed'
            }`}
          >
            {hasFormspreeId ? 'Enviar feedback' : 'Formulari no configurat'}
          </button>

          {!hasFormspreeId && (
            <p class="text-xs text-amber-600 mt-3 text-center">
              ⚠️ El formulari no està configurat (falta PUBLIC_FORMSPREE_ID). Veure consola per més detalls.
            </p>
          )}

          {/* Missatge d'error */}
          <div
            id="errorMessage"
            class="mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm hidden"
          ></div>
        </div>
      </form>

      {/* Missatge de gràcies */}
      <div id="successMessage" class="hidden text-center">
        <div class="mb-6">
          <div class="text-5xl mb-4">✅</div>
          <h2 class="text-2xl font-bold text-text-primary mb-3">
            Gràcies pel teu feedback!
          </h2>
          <p class="text-text-secondary mb-8">
            La teva opinió és valuosa i ens ajudarà a millorar el programa.
          </p>
          <button
            type="button"
            id="resetBtn"
            class="btn-primary"
          >
            Enviar un altre feedback
          </button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ formspreeId, hasFormspreeId }}>
  const form = document.getElementById('feedbackForm');
  const submitBtn = document.getElementById('submitBtn');
  const errorMessage = document.getElementById('errorMessage');
  const successMessage = document.getElementById('successMessage');
  const resetBtn = document.getElementById('resetBtn');

  // Stars rating
  const starsContainer = document.getElementById('starsContainer');
  const ratingInput = document.getElementById('rating');
  const ratingValue = document.getElementById('ratingValue');
  let currentRating = 0;

  starsContainer.addEventListener('click', (e) => {
    const star = e.target.closest('.star-rating');
    if (!star) return;

    const rating = parseInt(star.dataset.rating);
    currentRating = rating;
    ratingInput.value = rating;

    // Actualizar estrellas
    document.querySelectorAll('.star-rating').forEach((s) => {
      const starNum = parseInt(s.dataset.rating);
      s.textContent = starNum <= rating ? '★' : '☆';
      s.style.color = starNum <= rating ? '#E5322D' : '#ccc';
    });

    // Actualizar texto
    const labels = ['', 'Molt pobre', 'Pobre', 'Normal', 'Bé', 'Molt bé'];
    ratingValue.textContent = labels[rating] || '';
  });

  // Character counters
  const millorField = document.getElementById('millor');
  const millorarField = document.getElementById('millorar');
  const millorCount = document.getElementById('millorCount');
  const millorarCount = document.getElementById('millorarCount');

  function updateCounter(field, countSpan) {
    const len = field.value.length;
    countSpan.textContent = `${len} caràcters (mínim 10)`;
    if (len > 0 && len < 10) {
      countSpan.style.color = '#DC0000';
    } else {
      countSpan.style.color = '#999';
    }
  }

  millorField.addEventListener('input', () => updateCounter(millorField, millorCount));
  millorarField.addEventListener('input', () => updateCounter(millorarField, millorarCount));

  // Form submit
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Validaciones
    if (!hasFormspreeId) {
      errorMessage.textContent = 'Error: Formulari no configurat. Contacta amb l\'administrador.';
      errorMessage.classList.remove('hidden');
      return;
    }

    // Validar rating
    if (!ratingInput.value) {
      errorMessage.textContent = 'Si us plau, selecciona una valoració.';
      errorMessage.classList.remove('hidden');
      return;
    }

    // Validar email si s'ha omplert
    const emailField = document.getElementById('email');
    if (emailField.value && !emailField.value.includes('@')) {
      errorMessage.textContent = 'Si us plau, entra un email vàlid.';
      errorMessage.classList.remove('hidden');
      return;
    }

    // Preparar dades
    const formData = new FormData(form);
    const data = {
      nom: formData.get('nom') || '(No especificat)',
      rol: formData.get('rol'),
      bloc: formData.get('bloc'),
      rating: formData.get('rating'),
      millor: formData.get('millor'),
      millorar: formData.get('millorar'),
      aplicat: formData.get('aplicat') || '(No especificat)',
      email: formData.get('email') || '(No especificat)',
    };

    // Enviar a Formspree
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviant...';
    errorMessage.classList.add('hidden');

    try {
      const response = await fetch(`https://formspree.io/f/${formspreeId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        // Èxit
        form.classList.add('hidden');
        successMessage.classList.remove('hidden');
      } else {
        throw new Error('Error en l\'enviament');
      }
    } catch (error) {
      // Error
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar feedback';
      errorMessage.textContent =
        'Hi ha hagut un error en l\'enviament. Si us plau, intenta-ho més tard.';
      errorMessage.classList.remove('hidden');
      console.error('Error:', error);
    }
  });

  // Reset button
  resetBtn.addEventListener('click', () => {
    form.reset();
    form.classList.remove('hidden');
    successMessage.classList.add('hidden');
    errorMessage.classList.add('hidden');
    submitBtn.disabled = false;
    submitBtn.textContent = 'Enviar feedback';
    currentRating = 0;
    ratingInput.value = '';
    ratingValue.textContent = '';

    document.querySelectorAll('.star-rating').forEach((s) => {
      s.textContent = '☆';
      s.style.color = '#ccc';
    });

    millorCount.textContent = '';
    millorarCount.textContent = '';
  });
</script>

