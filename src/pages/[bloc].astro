---
import { getCollection } from 'astro:content';
import ModuleLayout from '../layouts/ModuleLayout.astro';
import PracticeExercise from '../components/PracticeExercise.astro';
import CommandBlock from '../components/CommandBlock.astro';
import ArtifactCard from '../components/ArtifactCard.astro';
import PdfDownload from '../components/PdfDownload.astro';

export async function getStaticPaths() {
  const blocs = await getCollection('blocs');
  
  return blocs.map((entry) => ({
    params: { bloc: entry.data.blockId },
    props: { entry },
  }));
}

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const {
  title,
  blockId,
  duration,
  audience,
  date,
  objective,
  keyTopics,
  practiceExercise,
  commands,
  screenshots,
  artifact,
  resources,
  pdfFile,
  prevBlock,
  nextBlock,
} = entry.data;
---

<ModuleLayout
  title={title}
  blockId={blockId}
  duration={duration}
  audience={audience}
  date={date}
  prevBlock={prevBlock}
  nextBlock={nextBlock}
>
  {/* Link ràpid a comandos */}
  {commands && commands.length > 0 && (
    <div class="mb-10">
      <a href="#comandos" class="inline-flex items-center gap-2 text-sm font-medium text-elink hover:underline">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>
        </svg>
        Anar a Comandos i exemples
      </a>
    </div>
  )}

  {/* Secció d'objectiu */}
  <section class="mb-16">
    <h2>Objectiu del bloc</h2>
    <p class="text-lg text-text-secondary">{objective}</p>
  </section>

  {/* Conceptes clau */}
  <section class="mb-16">
    <h2>Conceptes clau</h2>
    <div class="space-y-3">
      {keyTopics.map((topic: any) => (
        <div class="flex items-center justify-between p-4 bg-bg-light rounded-lg border border-gray-200">
          <span class="font-medium text-text-primary">{topic.name}</span>
          <span class="text-small text-text-secondary bg-white px-3 py-1 rounded">
            {topic.duration}
          </span>
        </div>
      ))}
    </div>
    <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg text-small text-text-secondary">
      <strong>Temps total:</strong> {duration}
    </div>
  </section>

  {/* Contingut markdown */}
  <section class="mb-16 detailed-content">
    <Content />
  </section>

  {/* Exercici pràctic */}
  <section class="mb-16">
    <PracticeExercise title={practiceExercise.title}>
      <p>{practiceExercise.description}</p>

      {commands && commands.length > 0 && (
        <div class="mt-8">
          <h4 id="comandos" class="font-bold text-lg mb-6">Comandos i exemples</h4>
          {commands.map((cmd: any, idx: number) => (
            <CommandBlock
              key={idx}
              code={cmd.code}
              language={cmd.language || 'bash'}
              label={cmd.label}
            />
          ))}
        </div>
      )}
    </PracticeExercise>
  </section>

  {/* Lliurables */}
  <section class="mb-16">
    <ArtifactCard
      title="Artefactes que hauries de tenir"
      items={artifact}
    />
  </section>

  {/* PDF Download + recursos addicionals */}
  <section class="mb-16">
    <h2>Recursos addicionals</h2>
    <PdfDownload
      href={`/pdfs/${pdfFile}`}
      filename={pdfFile}
    />
    {resources && resources.length > 0 && (
      <div class="mt-4 space-y-3">
        {resources.map((r: any) => (
          <a
            href={r.href}
            download
            class="flex items-start gap-4 p-4 rounded-lg border border-border-subtle bg-white hover:border-elink hover:shadow-sm transition-all no-underline group"
          >
            <div class="mt-0.5 text-text-secondary group-hover:text-elink transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="12" y1="18" x2="12" y2="12"/>
                <polyline points="9 15 12 18 15 15"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-text-primary group-hover:text-elink transition-colors text-sm">{r.label}</p>
              {r.description && <p class="text-xs text-text-secondary mt-0.5">{r.description}</p>}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</ModuleLayout>
