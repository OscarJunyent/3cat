---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockCard from '../components/BlockCard.astro';

const allBlocs = await getCollection('blocs');
const blocsOrdered = allBlocs.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="3Cat × Elink - Portal de Formació en IA">

  <!-- HERO -->
  <section class="border-b border-[#F0F0F0] py-20 md:py-28">
    <div class="container-max">

      <div class="inline-flex items-center px-3 py-1 rounded-full bg-[#FFF0F0] border border-[#FFD5D4] text-elink text-xs font-semibold mb-8 tracking-wide">
        Abril – Juny 2026
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-[3.75rem] font-extrabold text-text-primary leading-[1.1] tracking-tight mb-6 max-w-3xl">
        Formació en Intel·ligència Artificial
      </h1>

      <p class="text-lg md:text-xl text-text-secondary leading-relaxed mb-10 max-w-2xl">
        Programa d'adopció d'IA per a l'àrea d'Enginyeria de 3Cat.<br />
        Materials, exercicis pràctics i artefactes de tots els blocs temàtics.
      </p>

      <div class="flex flex-wrap gap-4 mb-16">
        <a href="/blocs" class="btn-primary">Explora els blocs →</a>
      </div>

      <div class="flex flex-wrap items-center gap-5 md:gap-8">
        <img src="/images/elinkcat_logo.png" alt="Elinkcat" class="h-5 md:h-6 object-contain" />
        <span class="text-2xl text-[#D0D0D0] font-light select-none">×</span>
        <img src="/images/3Cat_logo.jpg" alt="3Cat" class="h-20 md:h-24 object-contain" />
        <span class="text-2xl text-[#D0D0D0] font-light select-none">×</span>
        <span class="inline-flex items-center gap-3">
          <img src="/images/capficat.jpeg" alt="Capficat" class="h-14 w-14 md:h-16 md:w-16 rounded-xl object-cover" />
          <span class="text-xl md:text-2xl font-bold text-[#078F83]">Capficat</span>
        </span>
      </div>
    </div>
  </section>

  <!-- ELS FORMADORS -->
  <section class="py-16 md:py-20 border-b border-border-subtle">
    <div class="container-max">
      <h2 class="text-2xl font-bold text-text-primary tracking-tight mb-10">Els formadors</h2>
      <div class="flex flex-col sm:flex-row gap-8">

        <div class="flex items-center gap-5">
          <img
            src="/images/oscar-linkedin.jpg"
            alt="Òscar Junyent"
            class="w-20 h-20 rounded-full object-cover flex-shrink-0"
          />
          <div>
            <p class="font-bold text-text-primary text-lg leading-tight">Òscar Junyent</p>
            <a
              href="https://www.linkedin.com/in/ojunyent/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 mt-2 text-sm text-[#0A66C2] hover:underline font-medium no-underline"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </div>
        </div>

        <div class="flex items-center gap-5">
          <img
            src="/images/pere-linkedin.jpg"
            alt="Pere Ayats"
            class="w-20 h-20 rounded-full object-cover flex-shrink-0"
          />
          <div>
            <p class="font-bold text-text-primary text-lg leading-tight">Pere Ayats</p>
            <a
              href="https://www.linkedin.com/in/pereayats/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 mt-2 text-sm text-[#0A66C2] hover:underline font-medium no-underline"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- BLOCS GRID -->
  <section class="py-16 md:py-20">
    <div class="container-max">
      <div class="mb-10">
        <h2 class="text-2xl font-bold text-text-primary tracking-tight mb-2">Blocs de Formació</h2>
        <p class="text-text-secondary">Programa complet de 7 mòduls i un hackathon final</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {blocsOrdered.map((entry) => {
          const { blockId, number, title, duration, audience, summary } = entry.data;
          return (
            <BlockCard
              id={blockId}
              number={number}
              title={title}
              duration={duration}
              audience={audience}
              summary={summary}
              href={`/${blockId}`}
            />
          );
        })}
      </div>
    </div>
  </section>

  <!-- SOBRE ELINK -->
  <section class="bg-bg-light border-y border-border-subtle py-16 md:py-20">
    <div class="container-max max-w-3xl">
      <h2 class="text-2xl font-bold text-text-primary tracking-tight mb-5">Sobre Elinkcat</h2>
      <p class="text-text-secondary leading-relaxed mb-4">
        A Elinkcat ens dediquem a dues coses: formar equips tècnics perquè treballin millor amb IA,
        i implementar les solucions que fan que això passi de veritat.
      </p>
      <p class="text-text-secondary leading-relaxed mb-8">
        Formació sobre GitHub Copilot, agents i MCP. Implementació de workflows, connectors i
        automatitzacions. Sempre sobre el codi i els sistemes reals de cada organització, mai sobre
        sandboxes genèriques.
      </p>
      <a href="https://elink.cat" target="_blank" rel="noopener noreferrer" class="btn-primary">
        Visita Elinkcat
      </a>
    </div>
  </section>

  <!-- MANTÉ'T ACTUALITZAT -->
  <section class="py-16 md:py-20">
    <div class="container-max">
      <h2 class="text-2xl font-bold text-text-primary tracking-tight mb-10">Estigues al dia</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <a href="https://lapindola.substack.com" target="_blank" rel="noopener noreferrer"
          class="group no-underline block">
          <div class="h-full p-8 rounded-xl border border-border-subtle hover:border-elink hover:shadow-[0_2px_12px_rgba(229,50,45,0.08)] transition-all duration-200">
            <div class="text-3xl mb-5">📧</div>
            <h3 class="text-lg font-bold text-text-primary group-hover:text-elink transition-colors tracking-tight mb-2">
              La Píndola de TecnologIA
            </h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-5">
              Més de 100 edicions setmanals sobre IA, eines i tendències. Tot el que necessites saber, cada setmana.
            </p>
            <span class="text-sm text-elink font-medium">Subscriu-te →</span>
          </div>
        </a>

        <a href="https://elink.cat/blog" target="_blank" rel="noopener noreferrer"
          class="group no-underline block">
          <div class="h-full p-8 rounded-xl border border-border-subtle hover:border-elink hover:shadow-[0_2px_12px_rgba(229,50,45,0.08)] transition-all duration-200">
            <div class="text-3xl mb-5">✍️</div>
            <h3 class="text-lg font-bold text-text-primary group-hover:text-elink transition-colors tracking-tight mb-2">
              Blog d'Elinkcat
            </h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-5">
              Opinions i novetats sobre el món de la IA: tendències, reflexions i tot el que cal saber per estar al dia.
            </p>
            <span class="text-sm text-elink font-medium">Llegeix els articles →</span>
          </div>
        </a>

      </div>
    </div>
  </section>

</BaseLayout>
