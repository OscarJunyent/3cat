/* Aquestes són les capçaleres recomanades per a la web estàtica.
   Nota: Si usas Nginx, aquestes no s'apliquen automàticament.
   Veure deploy/nginx-3cat-elink-cat.conf per a la configuració del servidor.
*/

/* Cacheig de assets */
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/* Cacheig de PDFs */
/pdfs/*
  Cache-Control: public, max-age=31536000, immutable

/* Cacheig de captures */
/screenshots/*
  Cache-Control: public, max-age=31536000, immutable

/* HTML sense cache (cada visita valida al servidor) */
/*.html
  Cache-Control: no-cache, must-revalidate, max-age=0

/* Security headers */
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://formspree.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; form-action 'self' https://formspree.io; frame-src 'none'; object-src 'none';
